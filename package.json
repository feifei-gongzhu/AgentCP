{
  "name": "sorne",
  "version": "0.1.0",
  "description": "Sorne 持续探索型渗透测试 Agent 系统 —— dsh 插件（规划—执行—保存—验证—再规划）",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "scripts": {
    "check": "node tools/check.mjs",
    "test": "npm run check && node --test \"test/*.test.mjs\"",
    "ui": "node test-ui-server.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7 || ^0.2.0-rc.2"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT"
}
