#!/usr/bin/env python3
"""Sorne 命令行入口：优先引导到项目自带的 .venv 解释器再启动。"""
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
VENV_PYTHON = ROOT / ".venv" / "bin" / "python"


def _reexec_into_venv() -> None:
    """系统 Python 往往缺少依赖；项目 venv 存在且尚未激活时切换过去。"""
    if not VENV_PYTHON.is_file():
        return
    if os.environ.get("SORNE_LAUNCHER_ACTIVE") == "1":
        return
    env = dict(os.environ)
    env["SORNE_LAUNCHER_ACTIVE"] = "1"
    try:
        os.execve(str(VENV_PYTHON), [str(VENV_PYTHON), __file__, *sys.argv[1:]], env)
    except OSError:
        return


_reexec_into_venv()

sys.path.insert(0, str(ROOT))

from src.sorne.cli import main


if __name__ == "__main__":
    main()
