# ==== 上游 AgentCP 仓库 .gitignore（V3.2）====
.DS_Store
.pytest_cache/
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Runtime project data may contain authorized targets, evidence and audit history.
projects/

# Local build and release artifacts.
release/
dist/
build/

# Local secrets and environment overrides.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Editor and temporary files.
.idea/
.vscode/
*.swp
*.tmp
*.log

# Target-specific local analysis inputs and one-off research helpers.
/analysis_input/
/scripts/

# ==== Windows 本地运行时（V3.3 备份补充）====
.venv-windows/
.agentcp-windows/
.agentcp-runtime/
.agentcp-work/
*.db-wal
*.db-shm
